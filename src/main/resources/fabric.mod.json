{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "Teleportation horns - use them to teleport to your spawn point or to a saved location.",
  "authors": [
    "RenardElectric",
    "Timeo"
  ],
  "license": "MIT",
  "icon": "assets/polyhorn/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "polycube.polyhorn.PolyHorn"
    ],
    "client": [
      "polycube.polyhorn.client.PolyHornClient"
    ],
    "fabric-datagen": [
      "polycube.polyhorn.client.DataGenerator"
    ]
  },
  "depends": {
    "java": ">=${java_version}",
    "minecraft": "26.3-pre.3",
    "fabricloader": ">=${loader_version}",
    "fabric-api": ">=${fabric_api_version}"
  },
  "accessWidener": "polyhorn.classtweaker"
}